// Prisma schema for Meeting Tracker
// MySQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  ISSUE
  CANCELLED
}

enum Theme {
  DARK
  LIGHT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(MEMBER)
  theme     Theme    @default(DARK)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedMeetings Meeting[]      @relation("MeetingOwner")
  members       Member[]       @relation("MemberUser")
  assignedTasks Task[]         @relation("TaskAssignee")
  comments      TaskComment[]
}

model Meeting {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  title     String?  @db.VarChar(200)
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User    @relation("MeetingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  groups Group[]

  @@index([ownerId, date])
}

model Group {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  color     String   @default("amber") @db.VarChar(20) // amber|rose|emerald|sky|violet|slate
  position  Int      @default(0)
  collapsed Boolean  @default(false)
  meetingId String
  createdAt DateTime @default(now())

  meeting Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  members Member[]

  @@index([meetingId, position])
}

model Member {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  position  Int      @default(0)
  groupId   String
  userId    String?
  createdAt DateTime @default(now())

  group Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User?  @relation("MemberUser", fields: [userId], references: [id], onDelete: SetNull)
  tasks Task[]

  @@index([groupId, position])
  @@index([userId])
}

model Task {
  id           String     @id @default(cuid())
  title        String     @db.VarChar(500)
  note         String?    @db.Text
  status       TaskStatus @default(TODO)
  position     Int        @default(0)
  memberId     String
  parentId     String?    // self-referential: null = top-level task, else a sub-task
  assigneeId   String?    // user responsible
  assigneeNote String?    @db.Text // private note from/to the assignee
  deadline     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  member   Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  parent   Task?         @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]        @relation("TaskSubtasks")
  assignee User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments TaskComment[]

  @@index([memberId, position])
  @@index([parentId, position])
  @@index([status])
  @@index([assigneeId])
  @@index([deadline])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}
